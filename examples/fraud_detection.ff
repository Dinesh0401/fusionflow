# Fraud detection — binary classification with risk-score feature engineering
# Run: fusionflow run examples/fraud_detection.ff --backend pandas --seed 42 --data-root examples

dataset transactions v1
    source "customers.csv"
end

pipeline fraud_pipe
    from transactions v1
    derive risk_score = (spend - income) / income
    where age >= 18
    features [age, income, risk_score]
    split 0.8
    target churned
end

model logreg
    type logistic_regression
    params { fit_intercept: true, max_iter: 1000, C: 1.0 }
end

experiment fraud_baseline
    description "Binary classification of suspicious transactions"
    uses pipeline fraud_pipe
    uses model logreg
    metrics [accuracy, f1]
end
